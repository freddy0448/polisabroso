@namespace Polisabroso.Shared.UI.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<div class="field">
    <label for="@Id">@Label</label>
    <div class="password-control">
        <input id="@Id" name="@Name" type="@(_visible ? "text" : "password")"
               autocomplete="@Autocomplete" placeholder="@Placeholder" required
               value="@Value" @oninput="HandleInput"
               aria-describedby="@DescriptionIds" aria-invalid="@(HasErrors ? "true" : "false")" />
        <button class="password-toggle" type="button" @onclick="ToggleVisibility"
                aria-controls="@Id" aria-label="@ToggleLabel" aria-pressed="@(_visible ? "true" : "false")">
            @(_visible ? "Ocultar" : "Mostrar")
        </button>
    </div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="field__hint" id="@(Id + "-hint")">@Hint</p>
    }
    @if (EditContext is not null && ValueExpression is not null)
    {
        <div id="@(Id + "-error")" aria-live="polite">
            <ValidationMessage For="@ValueExpression" />
        </div>
    }
</div>
