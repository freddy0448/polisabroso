@*Start point of the application*@
@page "/login"
@using Microsoft.AspNetCore.Components.Web
@using Polisabroso.Shared.UI.Components
@using Polisabroso.Shared.UI.Layout
@layout LoginLayout

<PageTitle>Iniciar sesión · Polisabroso</PageTitle>

<section class="login-page" aria-labelledby="login-title">
    <div class="login-page__grain" aria-hidden="true"></div>

    <article class="login-card">
        <div class="login-card__brand">
            <BrandLockup />
        </div>

        <p class="eyebrow">Bienvenido de vuelta</p>
        <h1 id="login-title">Tu buffet,<br />en orden.</h1>
        <p class="login-card__intro">Ingresa para organizar pedidos y mantener cada combinación clara desde la cocina hasta la entrega.</p>

        <form class="login-form" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="field">
                <label for="login-email">Correo electrónico</label>
                <input id="login-email"
                       name="email"
                       type="email"
                       autocomplete="username"
                       placeholder="nombre@negocio.com"
                       required />
            </div>

            <PasswordField Id="login-password" Name="password" Label="Contraseña"
                           Autocomplete="current-password" Placeholder="Ingresa tu contraseña"
                           @bind-Value="_password" />

            <div class="login-meta">
                <label class="check" for="login-remember">
                    <input id="login-remember" name="remember" type="checkbox" />
                    <span>Mantener sesión iniciada</span>
                </label>
                <a class="login-link" href="#" @onclick="HandleRecoveryPlaceholder" @onclick:preventDefault="true">¿Olvidaste tu contraseña?</a>
            </div>

            <button class="primary-action" type="submit">Iniciar sesión</button>
        </form>

        <p class="login-card__footer">Acceso exclusivo para el equipo de Polisabroso</p>
    </article>
</section>
