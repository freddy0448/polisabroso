<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <RootNamespace>Polisabroso</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Modules\Auth\docs\" />
    </ItemGroup>

    <Target Name="css:watch" BeforeTargets="build" Condition="$(Configuration) == 'Debug'">
        <Exec Command="npm run css:watch"/>
    </Target>
    <Target Name="css:build" BeforeTargets="build" Condition="$(Configuration) != 'Release'">
        <Exec Command="npm run css:build"/>
    </Target>
</Project>
